# Configurações do Servidor Fastify
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Segredo de Assinatura dos Tokens JWT
JWT_SECRET=supersecret-finance-hub-jwt-token-key-2025

# Banco de Dados
# 1. Desenvolvimento Local com SQLite (padrão):
# DATABASE_URL="file:./dev.db"

# 2. Produção na Vercel com Neon (PostgreSQL gratuito):
# Pegue sua connection string no painel do Neon (https://neon.tech)
DATABASE_URL="postgresql://neondb_owner:SUA_SENHA@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Origens permitidas para CORS (adicione a URL do seu frontend na Vercel)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://*.vercel.app"
